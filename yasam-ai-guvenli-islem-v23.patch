+            {selectedRoom.legal_matter_id && <div style={{ marginTop: 10, padding: 10, borderRadius: 10, background: "#f8fafc", fontSize: 12, color: "#475569" }}>✓ Hukuk & Uyum dosyasına bağlı</div>}
